%% Run All CatGT in Folder
% Note: Make sure you have ample memory space for this function
% Note: ***This will overwrite past CatGT files in dataPath***

% Written by: PO, March 2023
function [dataPath] = runall_CatGT(dataPath)

%% Get all files that need to run through CatGT

% Find subfolders of raw data
allFiles = rdir(dataPath);
allFiles_str = string(allFiles);
p=1;
for i = 1:length(allFiles_str)
    if isempty(strfind(allFiles_str{i,1},'.ap.meta'))
        %pass
    else
        str = extractBetween(allFiles_str{i,1},'imec','.ap.meta');
        dataFiles{p,1} = str{1,1}(3:end-9);
        p=p+1;
    end
end

for n = 1:length(dataFiles)
%% Create runit.bat file
    catGT_Folder = 'C:\SpikeGLX\CatGT'; % EDIT your catGT folder
    cd 'C:\SpikeGLX\CatGT'              % EDIT your catGT folder
    mainDir_str1 = [dataPath '\'];
    mainDir = strrep(mainDir_str1,'\','\\');
    subFolder = dataFiles{n,1};
    parentDir = erase(mainDir,subFolder);
    if parentDir(end-3:end) == '\\\\'
        parentDir = parentDir(1:end-2);
    end

    try
    if parentDir == mainDir
        destDir = [mainDir subFolder '\\'];
    else
        destDir = mainDir;
    end

    CatGTpart1 = ({'@echo off' '@setlocal enableextensions' ['@cd /d ' '"%%~dp0"'] '%\n'}); %get part 1
    
    CatGTpart2 = (['set LOCALARGS= -dir=' parentDir ' -run=' subFolder(1:end-3) ' -g=0 -t=0 ^']); %get part 2
    
    % EDIT You'll need to configure here to extract the ni channels you want
    CatGTpart3 = ({'-prb_fld -t_miss_ok ^' '-ap -ni ^' '-prb=0 ^' '-apfilter=butter,12,600,6000 ^' '-gblcar ^' '-xa=0,0,1,2,1,0  ^' '-xia=0,0,3,0.5,1,0 ^' '-xa=0,0,4,4,3,500 ^'}); %get part 3
    CatGTpart3_str = sprintf('%s\n',CatGTpart3{:}); %get part 5
    
    CatGTpart4 = ['-dest=' destDir '\']; %get part 4
    
    CatGTpart5 = {'if [%%1]==[] (set ARGS=%%LOCALARGS%%) else (set ARGS=%%*)' '%%~dp0CatGT %%ARGS%%'};
    
% You can enable this, but you will have to manually oversee each iteration    
%     if exist('runit.bat','file')
%         promptMessage = 'Runit.bat file already exists. Do you want to overwrite it?';
%         titleBarCaption = 'Overwrite?';
%         buttonText = questdlg(promptMessage, titleBarCaption, 'Yes', 'No', 'Yes');
%         if strcmpi(buttonText, 'No')
%             disp('Did not overwrite runit.bat file.')
%         elseif strcmpi(buttonText, 'Yes')
%             fileID = fopen('runit.bat','w');
%         else
%             disp('Did not overwrite runit.bat file.')
%         end
%     end

    CatGT_list = {CatGTpart1,CatGTpart2,CatGTpart3_str,CatGTpart4,CatGTpart5};
    fileID = fopen('runit.bat','w');
    for l = 1:length(CatGT_list)-1
        if l == 1
            for t = 1:length(CatGT_list{l})
                fprintf(fileID, sprintf('%s\n',CatGT_list{l}{t}));
            end
            fprintf(fileID, '\n');
        elseif l == 3
            fprintf(fileID, sprintf('%s\n',CatGT_list{l}(1:end-1)));
        else
            fprintf(fileID, sprintf('%s\n',CatGT_list{l}));
        end
    end

    fprintf(fileID, '\n');
    for ll = 1:length(CatGT_list{end})
        fprintf(fileID, '\n');
        fprintf(fileID, sprintf('%s\n',CatGT_list{end}{ll}));
    end
    fclose(fileID);

%% Run batch file in cmd line
    
%     if isfile(fullfile(dir(''), '*filename.txt'))
        sys_string = ['runit'];
        system(['cd ' catGT_Folder]);
        system(sys_string);
        display(sprintf('Subfolder %s found and ran through CatGT.',subFolder)); %#ok<*DSPS>  
%     else
%         display(sprintf('Skipping subfolder %s. It already ran through CatGT.',subFolder)); %#ok<*DSPS> 
%     end

end
end